{
  "name": "@driftboard/web",
  "version": "0.0.0",
  "private": true,
  "description": "driftboard web client (React 18 + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod": "tsc --noEmit && VITE_SYNC_URL=/ws vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@driftboard/crdt": "workspace:*",
    "@driftboard/protocol": "workspace:*",
    "idb": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "fast-check": "3.23.1",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8",
    "workbox-window": "7.4.1"
  }
}
