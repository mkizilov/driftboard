{
  "name": "driftboard",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first collaborative sticky-note board.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start:prod": "pnpm --filter @driftboard/web build:prod && pnpm --filter @driftboard/server start:prod",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:install": "pnpm --filter @driftboard/e2e install:browsers",
    "e2e": "pnpm --filter @driftboard/e2e e2e",
    "bench": "pnpm --filter @driftboard/bench bench",
    "bench:report": "pnpm --filter @driftboard/bench report",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:all": "pnpm check && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
