{
  "name": "@driftboard/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "driftboard sync server: WebSockets (ws) with SQLite persistence (better-sqlite3).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "start:prod": "NODE_ENV=production DRIFTBOARD_STATIC_DIR=${DRIFTBOARD_STATIC_DIR:-../web/dist} node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@driftboard/crdt": "workspace:*",
    "@driftboard/protocol": "workspace:*",
    "better-sqlite3": "11.7.0",
    "tsx": "4.19.2",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "fast-check": "3.23.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
